generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  patient
  doctor
  admin
  researcher
}

enum UserStatus {
  active
  inactive
}

enum Gender {
  male
  female
  other
}

enum BloodType {
  A_POS  @map("A+")
  A_NEG  @map("A-")
  B_POS  @map("B+")
  B_NEG  @map("B-")
  AB_POS @map("AB+")
  AB_NEG @map("AB-")
  O_POS  @map("O+")
  O_NEG  @map("O-")
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  rescheduled
  cancelled
}

enum UrgencyLevel {
  low
  medium
  high
  emergency
}

enum Severity {
  mild
  moderate
  severe
}

enum FindingSeverity {
  low
  moderate
  high
}

enum NotificationType {
  info
  warning
  urgent
  success
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  passwordHash String
  phone        String?
  role         Role
  department   String?
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  patientProfile    PatientProfile?
  doctorProfile     DoctorProfile?
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor  Appointment[] @relation("DoctorAppointments")
  consultationNotes ConsultationNote[]
  vitals            Vital[]
  uploadedImages    MedicalImage[]   @relation("UploadedBy")
  patientImages     MedicalImage[]   @relation("PatientImages")
  radiologicalNotes RadiologicalNote[]
  aiScreenings      AiScreening[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("users")
}

model PatientProfile {
  id               String     @id @default(uuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime
  gender           Gender
  bloodType        BloodType?
  heightCm         Decimal?
  weightKg         Decimal?
  hasHypertension  Boolean    @default(false)
  hasDiabetes      Boolean    @default(false)
  hasAsthma        Boolean    @default(false)
  hasHeartDisease  Boolean    @default(false)
  additionalNotes  String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  allergies Allergy[]

  @@map("patient_profiles")
}

model Allergy {
  id        String         @id @default(uuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())

  @@map("allergies")
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization String
  licenseNumber  String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("doctor_profiles")
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  patient      User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId     String
  doctor       User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  scheduledAt  DateTime
  status       AppointmentStatus @default(pending)
  urgencyLevel UrgencyLevel?
  reason       String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  consultationNotes ConsultationNote[]
  vitals            Vital[]
  medicalImages     MedicalImage[]
  aiScreenings      AiScreening[]

  @@map("appointments")
}

model AiScreening {
  id                      String        @id @default(uuid())
  patientId               String
  patient                 User          @relation(fields: [patientId], references: [id])
  appointmentId           String?
  appointment             Appointment?  @relation(fields: [appointmentId], references: [id])
  chatHistory             Json?
  severity                Severity?
  urgencyLevel            UrgencyLevel?
  preliminaryAssessment   String?
  suggestedSpecialization String?
  priorityTimeframe       String?
  createdAt               DateTime      @default(now())

  @@map("ai_screenings")
}

model ConsultationNote {
  id             String      @id @default(uuid())
  appointmentId  String
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         User        @relation(fields: [doctorId], references: [id])
  content        String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("consultation_notes")
}

model Vital {
  id             String       @id @default(uuid())
  patientId      String
  patient        User         @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  bloodPressure  String?
  temperatureC   Decimal?
  heartRate      Int?
  oxygenSat      Decimal?
  recordedAt     DateTime     @default(now())

  @@map("vitals")
}

model MedicalImage {
  id                  String       @id @default(uuid())
  patientId           String
  patient             User         @relation("PatientImages", fields: [patientId], references: [id])
  appointmentId       String?
  appointment         Appointment? @relation(fields: [appointmentId], references: [id])
  fileName            String
  storagePath         String
  annotatedImagePath  String?
  mimeType            String
  uploadedById        String
  uploadedBy          User         @relation("UploadedBy", fields: [uploadedById], references: [id])
  uploadedAt          DateTime     @default(now())

  xrayAiFindings    XrayAiFinding[]
  radiologicalNotes RadiologicalNote[]

  @@map("medical_images")
}

model XrayAiFinding {
  id            String          @id @default(uuid())
  imageId       String
  image         MedicalImage    @relation(fields: [imageId], references: [id], onDelete: Cascade)
  findingNumber Int
  description   String
  confidence    Decimal?
  severity      FindingSeverity?
  createdAt     DateTime        @default(now())

  @@map("xray_ai_findings")
}

model RadiologicalNote {
  id        String       @id @default(uuid())
  imageId   String
  image     MedicalImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    User         @relation(fields: [doctorId], references: [id])
  content   String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("radiological_notes")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  actionType  String
  targetType  String
  targetId    String?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
